{
  "manifest_version": 3,
  "name": "AncestralWhisper - Tổ Tiên Mách Bảo",
  "version": "1.0.0",
  "description": "Tai nghe mắt thấy, mách chuẩn từng câu - Trợ lý giải đề thi multimodal bằng AI.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AncestralWhisper Settings"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "css": ["content/content.css"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/content.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
