# ==========================================
# AncestralWhisper - Configuration File (.env)
# ==========================================

# 1. Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 2. Model Gemini ưu tiên (Tùy chọn: auto, gemini-3.8-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=auto

# 3. Chế độ giải đề: semi-auto (khuyên dùng) hoặc auto
DEFAULT_MODE=semi-auto
